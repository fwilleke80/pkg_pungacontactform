<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
    <name>com_pungacontactform</name>
    <author>Punga</author>
    <creationDate>2026-10</creationDate>
    <copyright>Copyright (C) 2026 Punga</copyright>
    <license>GNU General Public License version 2 or later</license>
    <version>0.1.2</version>
    <description>COM_PUNGACONTACTFORM_XML_DESCRIPTION</description>
    <namespace path="src">Punga\Component\Pungacontactform</namespace>
    <install>
        <sql><file driver="mysql" charset="utf8">sql/install.mysql.sql</file><file driver="postgresql" charset="utf8">sql/install.postgresql.sql</file></sql>
    </install>
    <uninstall>
        <sql><file driver="mysql" charset="utf8">sql/uninstall.mysql.sql</file><file driver="postgresql" charset="utf8">sql/uninstall.postgresql.sql</file></sql>
    </uninstall>
    <files folder="site">
        <folder>src</folder><folder>tmpl</folder>
    </files>
    <languages folder="site">
        <language tag="en-GB">language/en-GB/com_pungacontactform.ini</language>
        <language tag="de-DE">language/de-DE/com_pungacontactform.ini</language>
    </languages>
    <media destination="com_pungacontactform" folder="media"><folder>css</folder></media>
    <administration>
        <menu img="class:envelope">COM_PUNGACONTACTFORM</menu>
        <files folder="admin">
            <filename>config.xml</filename><filename>access.xml</filename><folder>services</folder><folder>src</folder><folder>tmpl</folder><folder>sql</folder>
        </files>
        <languages folder="admin">
            <language tag="en-GB">language/en-GB/com_pungacontactform.ini</language>
            <language tag="en-GB">language/en-GB/com_pungacontactform.sys.ini</language>
            <language tag="de-DE">language/de-DE/com_pungacontactform.ini</language>
            <language tag="de-DE">language/de-DE/com_pungacontactform.sys.ini</language>
        </languages>
    </administration>
</extension>
